#------------------------------------------------------------------------------
# CONNECTION SETTINGS
#------------------------------------------------------------------------------
listen_addresses = '*'          # Listen on all interfaces (default: localhost)
port = 5432                     # Default port

#------------------------------------------------------------------------------
# RESOURCE USAGE
#------------------------------------------------------------------------------
shared_buffers = 128MB          # Memory for shared data (e.g., 25% of RAM)
work_mem = 4MB                  # Memory per query
maintenance_work_mem = 64MB     # Memory for maintenance tasks (e.g., vacuum)

#------------------------------------------------------------------------------
# WAL SETTINGS
#------------------------------------------------------------------------------
wal_level = replica              # Options: minimal, replica, logical
max_wal_size = 1GB               # Maximum WAL size
min_wal_size = 80MB              # Minimum WAL size

#------------------------------------------------------------------------------
# CHECKPOINT SETTINGS
#------------------------------------------------------------------------------
checkpoint_timeout = 5min        # Max time between checkpoints
checkpoint_completion_target = 0.7  # Aim for 70% of interval

#------------------------------------------------------------------------------
# LOGGING
#------------------------------------------------------------------------------
logging_collector = on          # Enable log collection
log_directory = 'pg_log'        # Directory for logs
log_filename = 'postgresql-%Y-%m-%d.log'
log_statement = 'all'           # Log all SQL statements

#------------------------------------------------------------------------------
# CLIENT CONNECTION DEFAULTS
#------------------------------------------------------------------------------
client_encoding = 'utf8'        # Default client encoding
default_transaction_isolation = 'read committed'  # Default isolation level
timezone = 'UTC'                # Default timezone

#------------------------------------------------------------------------------
# AUTOVACUUM
#------------------------------------------------------------------------------
autovacuum = on                 # Enable autovacuum
autovacuum_max_workers = 3      # Max autovacuum processes
autovacuum_naptime = 1min       # Time between autovacuum runs

#------------------------------------------------------------------------------
# STATISTICS
#------------------------------------------------------------------------------
track_activities = on           # Track running queries
track_counts = on               # Track table/index usage

#------------------------------------------------------------------------------
# CUSTOM CONFIGURATIONS
#------------------------------------------------------------------------------
# Add any custom settings below